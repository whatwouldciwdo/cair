# Salin ke deploy/.env.production dan chmod 600. Jangan commit nilai aktual.
POSTGRES_DB=pltgu_ai
POSTGRES_USER=pltgu
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_MIN_24_KARAKTER
# URL-encode username/password bila mengandung karakter khusus (contoh: @ menjadi %40).
# Host boleh service internal `db` atau PostgreSQL eksternal yang dapat dijangkau container.
DATABASE_URL=postgresql://pltgu:GANTI_PASSWORD_DB_URL_ENCODED@db:5432/pltgu_ai?schema=public
AUTH_SECRET=GANTI_OUTPUT_OPENSSL_RAND_BASE64_48
METRICS_TOKEN=GANTI_OUTPUT_OPENSSL_RAND_HEX_32
GRAFANA_ADMIN_PASSWORD=GANTI_PASSWORD_GRAFANA
OLLAMA_BASE_URL=http://10.8.140.75:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
PUBLIC_HOST=10.8.140.67
BACKUP_RETENTION_DAYS=14